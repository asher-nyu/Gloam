{
  "name": "gloam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "build:node": "GLOAM_BUILD_TARGET=node vite build",
    "check:vercel": "node scripts/check-vercel-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node build",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "pnpm test --watch",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "data:cities": "node scripts/update-cities.mjs"
  },
  "dependencies": {
    "@azohra/meteo.grib": "0.1.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@lucide/svelte": "^1.45.0",
    "@vercel/functions": "^3.9.7",
    "bits-ui": "^2.19.2",
    "fflate": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/environment-jsdom-abstract": "30.5.1",
    "@jest/globals": "30.5.1",
    "@storybook/sveltekit": "^10.6.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.0.0",
    "jest": "30.5.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.0",
    "prettier-plugin-svelte": "^3.4.1",
    "sass": "^1.97.0",
    "storybook": "^10.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.0",
    "svelte-jester": "^5.0.0",
    "svelte-preprocess": "^6.0.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.0"
  }
}
